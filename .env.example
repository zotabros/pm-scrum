JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

TELEGRAM_BOT_TOKEN=

# Optional: enables LLM sprint-health note (llm.enabled in config.yaml must also be true)
ANTHROPIC_API_KEY=

# Optional: healthchecks.io ping URL
HEALTHCHECK_URL=

# Telegram bot webhook (required to run `npm run server`).
# Generate a 32+ char random string for the webhook path token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8081
# Comma-separated Telegram user IDs that bypass admin check for /project.
TELEGRAM_ADMIN_USER_IDS=

LOG_LEVEL=info
NODE_ENV=production
