{
  "name": "scrum-digest",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Jira sprint digest → Telegram",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "server:start": "node dist/server.js",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "migrate-subscriptions": "tsx scripts/migrate-subscriptions.ts",
    "check": "tsx src/check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
