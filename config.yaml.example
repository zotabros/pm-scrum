timezone: Asia/Ho_Chi_Minh
run_on_weekdays_only: true

# If true, scan all projects visible to the Jira user.
# If false, only projects listed below are considered.
auto_discover_all: false

# Telegram chat subscriptions are managed at runtime via the bot's /project
# command and persisted to data/subscriptions.json. Only the project key (and
# optional jira_instance) is configured here.
projects:
  - key: PROJ-A
  - key: PROJ-B
    jira_instance: toptop

# Sprint-health note generated by Claude (optional).
llm:
  enabled: false
  model: claude-haiku-4-5-20251001
  language: vi

# V1: wall-clock. V2 may add business-hours-only calculation.
hours_calculation:
  business_hours_only: false
