# aaPanel → Website → Add Site (scrum.dzapp.io.vn) → Settings → Config (Reverse Proxy)
# Or paste this server block directly under /www/server/panel/vhost/nginx/scrum.dzapp.io.vn.conf
# Run aaPanel "Apply for SSL (Let's Encrypt)" first, then re-paste this block.
#
# What it does:
#   - HTTPS-only reverse proxy → Node bot at 127.0.0.1:8081
#   - /telegram/webhook/* is the only POST surface that matters; only forward expected paths.
#   - Tight body size + timeouts; Telegram updates are tiny.

server {
    listen 80;
    server_name scrum.dzapp.io.vn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name scrum.dzapp.io.vn;

    # SSL — managed by aaPanel Let's Encrypt; replace paths if different.
    ssl_certificate     /www/server/panel/vhost/cert/scrum.dzapp.io.vn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/scrum.dzapp.io.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 1m;

    # Health endpoint — handy for uptime monitoring.
    location = /healthz {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        access_log off;
    }

    # Telegram webhook — secret path token is appended by setWebhook.
    location ^~ /telegram/webhook/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
        proxy_send_timeout 10s;
    }

    # Anything else → 404. The bot has no other public surface.
    location / {
        return 404;
    }
}
